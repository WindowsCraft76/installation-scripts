#!/bin/sh
set -eu

echo "Init..."

fpm_path=$(command -v fpm 2>/dev/null || true)
if [ -z "$fpm_path" ]; then
	echo "Error: fpm is not installed. Install Ruby and fpm: sudo apt install ruby-full && sudo gem install fpm" >&2
	exit 1
fi
if [ ! -x "$fpm_path" ]; then
	echo "Error: fpm is not executable: $fpm_path" >&2
	exit 1
fi

rpmbuild_path=$(command -v rpmbuild 2>/dev/null || true)
if [ -z "$rpmbuild_path" ]; then
	echo "Error: rpmbuild is not installed. Install it with: sudo apt install rpm" >&2
	exit 1
fi

chmod +x pkgroot/opt/Name/Name
chmod +x pkgroot/usr/bin/name

# --architecture amd64 or arm64
(
	cd pkgroot
	fpm -s dir -t rpm \
		-n name \
		-v 0.1.0 \
		--description "Name" \
		--url "https://example.com/" \
		--license "Unknown" \
		--architecture amd64 \
		opt usr
	mv ./*.rpm ..
)

echo "Finish!"
